# Copy to .env and fill in. Never commit .env.
AURION_USERNAME=
AURION_PASSWORD=

# Optional overrides (defaults shown)
# AURION_BASE_URL=https://aurion.junia.com
# AURION_TIMEZONE=Europe/Paris
# CSS class of the "My Schedule" entry in the Aurion sidebar
# AURION_PLANNING_MENU_ITEM=item_2169484
# Longest range (in days) a single call may ask for
# AURION_MAX_RANGE_DAYS=366
# Per-request timeout in milliseconds (a whole year takes about 5 s)
# AURION_REQUEST_TIMEOUT_MS=30000

# --- HTTP server (pnpm dev / pnpm start) ---
# Listen on all interfaces only behind a reverse proxy or with API_TOKEN set
# HOST=127.0.0.1
# PORT=3000
# When set, /v1 requests need "Authorization: Bearer <token>" (generate: openssl rand -hex 32)
# API_TOKEN=
# How long Aurion answers are reused, in seconds (0 disables the cache)
# CACHE_TTL_SECONDS=900
# fatal | error | warn | info | debug | trace | silent
# LOG_LEVEL=info
